{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/feature-card-guard.sh\"",
            "if": "Bash(git commit*)",
            "timeout": 15,
            "statusMessage": "Checking feature cards"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/feature-card-report.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
